{
  "name": "@octane-xplat/nativescript-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Go library and CLI for NativeScript build and device tooling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/octane-xplat/nativescript-cli"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.3",
    "bplist-creator": "0.1.0",
    "bplist-parser": "0.3.1",
    "esbuild": "0.25.12",
    "google-protobuf": "4.0.2",
    "grpc-tools": "1.13.1",
    "plist": "3.1.1",
    "xcode": "3.0.1"
  },
  "scripts": {
    "helper:generate": "node tools/helper/generate.mjs",
    "helper:check": "node tools/helper/generate.mjs --check"
  },
  "exports": {
    "./plugin": {
      "types": "./plugin/index.d.ts",
      "require": "./plugin/index.cjs",
      "default": "./plugin/index.cjs"
    }
  }
}
